  /* ---- the CV taped to the "All files" drawer ---- */
  .cabinet {
    position: relative;
    z-index: 1; /* above the bee waiting behind it */
  }
  /* Placed over the closed "All files" drawer (cabinet padding 12px, drawer 276px wide): the sheet's right
     edge 14px inside the drawer's, its top 11px below the drawer's top (the svg starts 8px higher, room for
     the tape). Kept clear of the centred label and of the drawer below. */
  .cv-sheet {
    position: absolute;
    top: 15px;
    right: 26px;
    width: 50px;
    transform: rotate(-4deg);
    transform-origin: 50% 10.42%; /* the sheet's top edge, where the tape is */
    transition: transform 320ms ease; /* same slide as the drawers */
  }
  /* it slides out and back in with its drawer */
  .drawer[data-k='all'][aria-pressed='true'] ~ .cv-sheet {
    transform: translateX(24px) rotate(-4deg);
  }
  .cv-sheet svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: #9a9488;
    filter: drop-shadow(2px 4px 3px rgba(20, 23, 26, 0.38));
    transform-origin: 50% 10.42%;
  }
  .cv-sheet .tape {
    fill: #e9dfb4;
    opacity: 0.85;
  }
  /* a gust from below: the free bottom edge lifts towards you (rotateX around the taped top), flutters, settles */
  .cv-sheet.gust svg {
    animation: cv-gust 1.3s ease-in-out;
  }
  .cv-sheet.flutter svg {
    animation: cv-gust 1.3s ease-in-out infinite; /* same name: taking over a running gust doesn't restart it */
  }
  @keyframes cv-gust {
    0% {
      transform: perspective(240px) rotateX(0deg) rotateZ(0deg);
    }
    14% {
      transform: perspective(240px) rotateX(50deg) rotateZ(3deg);
    }
    30% {
      transform: perspective(240px) rotateX(16deg) rotateZ(-2deg);
    }
    46% {
      transform: perspective(240px) rotateX(32deg) rotateZ(1.5deg);
    }
    64% {
      transform: perspective(240px) rotateX(7deg) rotateZ(-1deg);
    }
    80% {
      transform: perspective(240px) rotateX(12deg) rotateZ(0.5deg);
    }
    100% {
      transform: perspective(240px) rotateX(0deg) rotateZ(0deg);
    }
  }
