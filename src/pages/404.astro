---
// 404: canvas Round 36 A ("NotFoundFog", v2). No header: just the title, the lost hiker in the fog
// (LostScene, generated by scripts/lost/lost.py) and a single signpost plate pointing back home.
import Base from '../layouts/Base.astro';
import LostScene from '../components/LostScene.astro';
---

<Base zoom={false} description="This page doesn't exist.">
  <div class="lost">
    <LostScene />

    <main class="copy">
      <p class="kicker">404 · off the trail</p>
      <h1>Got lost?</h1>
    </main>

    <nav class="post" aria-label="Way back">
      <a class="plate" href="/">
        <svg class="shape" viewBox="0 0 210 56" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M210 1 H18 L1 28 L18 55 H210"></path>
        </svg>
        <span class="label">Home</span>
      </a>
    </nav>
  </div>
</Base>

<style>
  .lost {
    position: relative;
    overflow: hidden;
    background: var(--paper); /* the sky; html and body are the ground colour (global.css) */
    min-height: 100vh;
    min-height: 100svh;
  }

  .copy {
    position: relative;
    z-index: 2;
    max-width: 560px;
    padding: clamp(48px, 16vh, 190px) clamp(16px, 3vw, 40px) 0 clamp(16px, 8vw, 128px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .kicker {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.95;
  }

  /* One plate pointing left (back), on a post placed like the home page signpost. Same outline and hover
     as Signpost.astro, mirrored: the post and the plate's right edge never move, the tip reaches further. */
  .post {
    --post: 3px;
    --plate-w: 210px;
    --plate-h: 56px;
    --reach: 12px;
    position: absolute;
    z-index: 2;
    right: clamp(16px, 10vw, 160px);
    right: round(clamp(16px, 10vw, 160px), 1px);
    bottom: 18%;
    bottom: round(18%, 1px);
    width: calc(var(--post) + var(--plate-w));
    border-left: var(--post) solid var(--ink);
    padding: 16px 0 150px;
  }

  .plate {
    position: relative;
    display: block;
    width: var(--plate-w);
    height: var(--plate-h);
    margin-left: calc(-1 * (var(--plate-w) + var(--post)));
    text-decoration: none;
  }

  .shape {
    position: absolute;
    right: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: width 220ms ease;
  }
  .shape path {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .label {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    font-family: var(--serif);
    font-size: 23px;
    color: var(--ink);
  }

  .plate:hover .shape,
  .plate:focus-visible .shape {
    width: calc(100% + var(--reach));
  }
  .plate:focus-visible {
    outline: none;
  }
  .plate:focus-visible .shape path {
    stroke-width: 3px;
  }

  @media (max-width: 760px) {
    .post {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 40px 0 240px calc(50% + 40px);
    }
  }

  /* Tall, narrow screens: the scene is cropped around its middle (x 720), and the hiker stops at x≈486, out of
     view. Keep the scene's aspect ratio at full height and shift it so that he stands at 28% of the width,
     clear of the Home plate (right on tablets, above him on phones). */
  @media (max-aspect-ratio: 4/5) {
    .lost :global(.lost-scene) {
      inset: 0 auto 0 28%;
      width: auto;
      aspect-ratio: 1440 / 810;
      transform: translateX(-33.75%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape {
      transition: none;
    }
  }
</style>
