---
import type { Social, SocialKind } from '../data/site';

interface Props {
  socials: Social[];
}

const { socials } = Astro.props;
const visible = socials.filter((s) => s.href);

// Inline icons, drawn in currentColor so they follow the link color.
const icons: Record<SocialKind, { viewBox: string; fill: boolean; body: string; size: number }> = {
  github: {
    viewBox: '0 0 16 16',
    fill: true,
    size: 23,
    body: '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>',
  },
  linkedin: {
    viewBox: '0 0 24 24',
    fill: false,
    size: 23,
    body: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v6"/><path d="M12 17v-6"/><path d="M12 13.5c0-1.5 1-2.5 2.3-2.5s2.2 1 2.2 2.5V17"/><circle cx="8" cy="7.6" r="0.9" fill="currentColor"/>',
  },
  scholar: {
    viewBox: '0 0 24 24',
    fill: false,
    size: 24,
    body: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path d="M22 9v6"/>',
  },
  strava: {
    viewBox: '0 0 24 24',
    fill: true,
    size: 22,
    body: '<path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>',
  },
  email: {
    viewBox: '0 0 24 24',
    fill: false,
    size: 23,
    body: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7.5l9 6 9-6"/>',
  },
};
---

<div class="links">
  {
    visible.map((s) => {
      const icon = icons[s.kind];
      const external = s.href.startsWith('http');
      return (
        <a
          href={s.href}
          aria-label={s.label}
          title={s.label}
          {...(external ? { rel: 'noopener', target: '_blank' } : {})}
        >
          <svg
            aria-hidden="true"
            width={icon.size}
            height={icon.size}
            viewBox={icon.viewBox}
            fill={icon.fill ? 'currentColor' : 'none'}
            stroke={icon.fill ? 'none' : 'currentColor'}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icon.body}
          />
        </a>
      );
    })
  }
</div>

<style>
  .links {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 0 16px 18px;
  }
  a {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 150ms ease;
  }
</style>
