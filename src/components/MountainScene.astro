---
// Decorative background from the Round 11 Q1 mockup: misty ridges, a road, fog and wind
// streaks (scripts/wind.ts) and birds. The figures (climbers, camp, riders, skier) are in SceneFigures,
// a separate layer above the title.
// Drawn in a 1440x810 box (the ridges run on to x -1100..2540 for wide windows) and anchored to the bottom.
// The box is sized by --sw (set on .home in index.astro), so the scene, figures, signpost and title keep the
// same proportions at any window size.
import Road from './Road.astro';
---

<svg
  class="scene"
  aria-hidden="true"
  viewBox="0 0 1440 810"
  preserveAspectRatio="xMidYMax meet"
>
  <defs>
    <filter id="mist" x="-5%" y="-20%" width="110%" height="140%">
      <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
    </filter>
    <radialGradient id="fog-puff">
      <stop offset="0" style="stop-color: var(--paper); stop-opacity: 1"></stop>
      <stop offset="1" style="stop-color: var(--paper); stop-opacity: 0"></stop>
    </radialGradient>
  </defs>

  <!-- Ridges, back to front, each blurred on its own so the drifting fog between them (wind.ts) does not
       make the browser re-blur the whole range every frame -->
  <g>
    <path class="ridge-back" filter="url(#mist)" fill="var(--ridge-back)" d="M-1100 470 C-1000 440 -900 420 -800 450 C-700 480 -620 400 -520 420 C-420 440 -360 500 -260 480 C-180 465 -120 570 0 520 C120 470 200 500 300 450 C380 410 430 470 520 440 C640 400 700 330 780 400 C860 470 940 430 1040 380 C1140 330 1200 420 1290 400 C1360 386 1410 420 1440 410 C1470 400 1540 360 1620 380 C1700 400 1760 440 1860 420 C1960 400 2020 340 2120 360 C2220 380 2300 430 2400 420 C2460 414 2500 400 2540 400 L2540 810 L-1100 810 Z"></path>
    <g class="fog" data-ridge="ridge-mid"></g>
    <path class="ridge-mid" filter="url(#mist)" fill="var(--ridge-mid)" d="M-1100 560 C-980 530 -860 560 -740 580 C-620 600 -520 540 -400 550 C-280 560 -140 640 0 600 C140 560 240 590 360 540 C460 500 540 560 660 530 C800 495 880 560 1000 520 C1120 480 1220 540 1440 500 C1550 480 1640 470 1740 490 C1840 510 1900 540 2020 520 C2140 500 2200 470 2320 480 C2420 490 2480 510 2540 505 L2540 810 L-1100 810 Z"></path>
    <g class="fog" data-ridge="ridge-front"></g>
    <path class="ridge-front" filter="url(#mist)" fill="var(--ridge-front)" d="M-1100 690 C-960 670 -820 700 -680 705 C-540 710 -380 680 -300 690 C-220 700 -120 730 0 700 C200 650 380 690 560 660 C760 628 900 690 1100 650 C1240 624 1360 660 1440 640 C1520 620 1600 610 1700 625 C1800 640 1880 660 2000 650 C2120 640 2200 615 2320 625 C2420 633 2480 645 2540 640 L2540 810 L-1100 810 Z"></path>
  </g>

  <!-- Road on the front ridge (soft band), generated by scripts/road.py -->
  <Road />

  <!-- Birds: still fallback; Birds.astro animates them and hides this group -->
  <g class="static-birds" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.75">
    <path d="M420 180 q5 -5 10 0 q5 -5 10 0"></path>
    <path d="M900 150 q4 -4 8 0 q4 -4 8 0"></path>
    <path d="M968 172 q5 -5 10 0 q5 -5 10 0"></path>
    <path d="M1190 214 q4 -4 8 0 q4 -4 8 0"></path>
  </g>

  <!-- Wind streaks (wind.ts) -->
  <g class="streaks" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="round"></g>

</svg>

<style>
  .scene {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--sw);
    height: calc(var(--sw) * 810 / 1440);
    transform: translateX(-50%);
    /* the ridges reach past the 1440 box; .home clips what is off screen */
    overflow: visible;
    color: var(--ink);
    pointer-events: none;
  }
  :global(html.live-birds) .static-birds {
    display: none;
  }
</style>

<script>
  import { startWind } from '../scripts/wind';
  const scene = document.querySelector<SVGSVGElement>('svg.scene');
  if (scene) startWind(scene);
</script>
