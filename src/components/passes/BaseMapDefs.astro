---
// The base map (land, lakes, rivers, borders) once per page; every TourMap shows it through <use>.
import { basemapPaths } from '../../lib/tours';
---

<svg class="basemap-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <g id="basemap">
      <path class="bm-land" d={basemapPaths.land} fill-rule="evenodd"></path>
      <path class="bm-lakes" d={basemapPaths.lakes} fill-rule="evenodd"></path>
      <path class="bm-rivers" d={basemapPaths.rivers}></path>
      <path class="bm-borders" d={basemapPaths.borders}></path>
    </g>
  </defs>
</svg>

<style>
  .basemap-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* Strokes keep their screen width at every zoom level (non-scaling-stroke, dashes included). */
  .bm-land {
    fill: #ece5d6;
    stroke: #14171a;
    stroke-width: 0.9px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .bm-lakes {
    fill: #f7f3ea;
    stroke: #14171a;
    stroke-width: 0.7px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .bm-rivers {
    fill: none;
    stroke: #7d97ab;
    stroke-width: 0.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
    vector-effect: non-scaling-stroke;
  }
  .bm-borders {
    fill: none;
    stroke: #14171a;
    stroke-width: 0.7px;
    stroke-opacity: 0.4;
    stroke-dasharray: 2 2.5;
    vector-effect: non-scaling-stroke;
  }
</style>
