---
// The home page figures as still icons (fine ink line), drawn in currentColor.
// The SVGs are generated by scripts/icons/build.py from the figure scripts; don't edit them by hand.
import motorcycle from './icons/motorcycle.svg?raw';
import bicycle from './icons/bicycle.svg?raw';
import hiking from './icons/hiking.svg?raw';
import skiing from './icons/skiing.svg?raw';

interface Props {
  name: 'motorcycle' | 'bicycle' | 'hiking' | 'skiing';
  size?: number;
}

const { name, size = 64 } = Astro.props;
const raw = { motorcycle, bicycle, hiking, skiing }[name];
const svg = raw
  .replace(/<\?xml[^>]*>\s*/, '')
  .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|aria-hidden|focusable)="[^"]*"/g, ''))
  .replace('<svg', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
